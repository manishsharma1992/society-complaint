# Template for /etc/society-complaint/complaint.env on the Lightsail instance (root:root, chmod 600).
# Real values live only on the server. Never commit them.
# Use Neon's direct host (without "-pooler"): Flyway's migration lock needs a session.
DB_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require&channelBinding=require
DB_USER=<user>
DB_PASSWORD=<password>

# Later, when residency-service runs on the same box:
# RESIDENCY_BASE_URL=http://127.0.0.1:8082/api/residency

# This site's own private bucket (Lightsail -> Storage -> bucket -> Permissions -> Access keys)
PHOTO_BUCKET=<bucket name>
PHOTO_BUCKET_REGION=ap-southeast-1
PHOTO_ACCESS_KEY=<access key id>
PHOTO_SECRET_KEY=<secret access key>

# Translate button (Amazon Translate). An IAM user allowed only translate:TranslateText and
# comprehend:DetectDominantLanguage. Leave out to switch translation off.
TRANSLATE_ACCESS_KEY=<access key id>
TRANSLATE_SECRET_KEY=<secret access key>
# Marathi goes to Google Cloud Translation (an API key restricted to the Cloud Translation API). Leave out to use
# Amazon for Marathi too.
GOOGLE_TRANSLATE_API_KEY=<api key>

# Login: signs tokens and hashes OTP codes. Generate once: openssl rand -hex 32
AUTH_SECRET=<64 random hex characters>
# Demo logins (6 digits) for the placeholder numbers 9000000001-9000000004. Remove to turn demo logins off.
OTP_DEMO_CODE=<6 digits>
